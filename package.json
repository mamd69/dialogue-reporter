{
  "name": "dialogue-reporter",
  "version": "1.0.1",
  "description": "Automatically log Claude Code conversations to beautiful markdown files",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dialogue-reporter": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:performance": "jest tests/performance",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "postinstall": "node dist/postinstall.js || true"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-flow",
    "conversation",
    "logging",
    "markdown",
    "mcp",
    "ai",
    "assistant",
    "documentation"
  ],
  "author": "Dialogue Reporter Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mamd69/dialogue-reporter.git"
  },
  "bugs": {
    "url": "https://github.com/mamd69/dialogue-reporter/issues"
  },
  "homepage": "https://github.com/mamd69/dialogue-reporter#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "templates",
    "scripts",
    "README.md",
    "LICENSE"
  ]
}
