{
  "mcpServers": {
    "dialogue-reporter": {
      "command": "node",
      "args": [
        "/home/codespace/nvm/current/lib/node_modules/dialogue-reporter/dist/mcp/server.js"
      ],
      "type": "stdio",
      "env": {
        "DIALOGUE_REPORTER_CONFIG": "/workspaces/dialogue-reporter/.dialogue-reporter.json"
      }
    },
    "claude-flow@alpha": {
      "command": "npx",
      "args": [
        "claude-flow@alpha",
        "mcp",
        "start"
      ],
      "type": "stdio"
    },
    "ruv-swarm": {
      "command": "npx",
      "args": [
        "ruv-swarm@latest",
        "mcp",
        "start"
      ],
      "type": "stdio"
    },
    "flow-nexus": {
      "command": "npx",
      "args": [
        "flow-nexus@latest",
        "mcp",
        "start"
      ],
      "type": "stdio"
    }
  }
}